# Replace placeholders with the published image prefix and matching release tag.
# No images are published by this example. Never put application secrets here.
IMAGE_PREFIX=registry.example.com/your-namespace/study-log
RELEASE_VERSION=replace-with-release-tag
# Dedicated absolute paths; INSTANCE_ROOT must be inside INSTANCE_PARENT.
INSTANCE_PARENT=/srv/study-log
INSTANCE_ROOT=/srv/study-log/instance
WEB_PORT=3560
