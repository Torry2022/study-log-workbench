{
  "name": "study-log-desktop",
  "productName": "学习日志工作台",
  "version": "0.1.0-rc.8",
  "private": true,
  "description": "本地学习日志工作台",
  "author": "Study Log Workbench contributors",
  "license": "MIT",
  "type": "module",
  "main": "main.mjs",
  "devDependencies": { "electron": "44.6.0", "electron-builder": "26.15.3" },
  "build": {
    "appId": "org.studylog.workbench.desktop",
    "asar": true,
    "directories": { "output": "../../.local/electron-dist" },
    "files": ["updates.mjs", "history.html", "history.mjs", "history-preload.cjs", "server-connection.mjs", "connection.html", "connection.css", "connection.mjs", "connection-preload.cjs", "titlebar.html", "titlebar.css", "titlebar.mjs", "titlebar-preload.cjs", "main.mjs", "preload.cjs", "settings.html", "settings.css", "settings.mjs", "settings-preload.cjs", "package.json"],
    "extraResources": [{ "from": "../../.local/electron-payload", "to": "payload", "filter": ["**/*", "!启动学习日志.vbs", "!使用说明.txt", "!docs/windows-portable.md", "!ops/desktop/launcher.mjs", "!ops/desktop/index.html", "!ops/desktop/ui.*"] }, { "from": "../../.local/electron-icon.png", "to": "icon.png" }, { "from": "../../docs/windows-desktop.md", "to": "使用说明.md" }, { "from": "../../study-log-web/public/scrollbars", "to": "scrollbars" }, { "from": "../../study-log-web/public/ui", "to": "ui" }],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "../../.local/electron-icon.ico" },
    "nsis": { "oneClick": false, "perMachine": false, "allowElevation": false, "allowToChangeInstallationDirectory": true, "deleteAppDataOnUninstall": false },
    "artifactName": "study-log-desktop-${version}-${arch}-setup.${ext}"
  }
}
