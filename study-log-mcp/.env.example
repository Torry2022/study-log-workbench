# Explicit absolute paths. Data and index must not overlap.
LOG_ROOT=/instance/data
INDEX_ROOT=/instance/index

# Required for HTTP only; replace with a locally generated random token.
MCP_HTTP_TOKEN=
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3020
# Comma-separated hostnames, no scheme or port. Add a reverse-proxy hostname explicitly.
MCP_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],study-log-mcp
# Origin is optional for native clients; a present Origin must pass this separate list.
MCP_HTTP_ALLOWED_ORIGINS=localhost,127.0.0.1,[::1],study-log-mcp

# Optional: all three fields required; URL is the full embeddings endpoint.
EMBEDDING_API_KEY=
EMBEDDING_API_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_MS=30000

# Independent opt-in reranking; no embedding/chat key fallback.
RERANK_ENABLED=false
RERANK_API_KEY=
RERANK_API_URL=
RERANK_MODEL=
RERANK_TIMEOUT_MS=30000
